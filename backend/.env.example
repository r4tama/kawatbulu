# Nomor WhatsApp admin/owner brand, format internasional TANPA tanda '+'
# Contoh: nomor 0812-3456-7890 -> 6281234567890
WA_ADMIN_NUMBER=6281234567890

# Port server backend (Express)
PORT=5000

# Origin frontend yang diizinkan akses API (untuk CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Base URL backend ini sendiri, dipakai catalog.js untuk membangun URL
# gambar produk yang absolut (http://.../images/keychains/...).
# Ganti ke domain production (mis. Vercel) saat deploy.
BACKEND_URL=http://localhost:5000
